# Server Configuration
FLASK_ENV=development
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Configuration
# For PostgreSQL (default production/container target):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cultural_committee
# For local zero-config standalone development when PostgreSQL server is not started:
DATABASE_URL=sqlite:///backend/cultural_committee.db

# Authentication & OTP Adapter Configuration
# Delivery mode: 'development' (logs OTP to backend terminal/logs) or 'smtp'
OTP_DELIVERY_MODE=development
OTP_EXPIRY_MINUTES=15
OTP_MAX_ATTEMPTS=5

# SMTP Configuration (only required if OTP_DELIVERY_MODE=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@tapmi.edu.in
SMTP_PASSWORD=placeholder_secret
SMTP_USE_TLS=true

# Pilot Event
PILOT_EVENT_NAME=Kala Fest
